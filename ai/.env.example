# 실제 값은 .env 에 넣고 커밋하지 마세요 (.gitignore 처리됨)

GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash

# 감정 모델 가중치. HF Hub private repo 또는 로컬 ai/models/ 경로
EMOTION_MODEL_PATH=models/orbit_emotion_v1.pth
EMOTION_TEXT_ENCODER=klue/roberta-small

# STT
# 1학기: 노션 일지는 base, 실제 OrbitCoreV4는 tiny를 썼습니다. 1주차에 확정하세요.
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# TTS
TTS_VOICE=ko-KR-InJoonNeural

# 백엔드(Spring Boot) 연동
BACKEND_BASE_URL=http://localhost:8080
