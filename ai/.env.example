# 실제 값은 .env 에 넣고 커밋하지 마세요 (.gitignore 처리됨)

GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash

# 감정 모델 가중치. HF Hub private repo 또는 로컬 ai/models/ 경로
EMOTION_MODEL_PATH=models/orbit_emotion_v1.pth
EMOTION_TEXT_ENCODER=klue/roberta-small

# STT
# 1학기: 노션 일지는 base, 실제 OrbitCoreV4는 tiny를 썼습니다. 1주차에 확정하세요.
WHISPER_MODEL_SIZE=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# TTS
TTS_VOICE=ko-KR-InJoonNeural

# 백엔드(Spring Boot) 연동
BACKEND_BASE_URL=http://localhost:8080
BACKEND_TIMEOUT_S=3.0

# 4단계 대중교통 판정 기준. 실내 테스트는 0 으로, 시연·실사용은 5 / 1
TRANSIT_MIN_MINUTES=5
TRANSIT_MIN_KM=1
# 촬영 시각과 서버 수신 시각 차이 허용(초). 휴대폰 시계가 틀리면 늘리기
TRANSIT_MAX_CAPTURE_AGE_S=60
